<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\Survivalcraft\Survivalcraft.props" />
    <Import Project="..\build\Android.props" />
    <PropertyGroup>
        <NoWarn>$(NoWarn);XA0141;XA4301;NU1605</NoWarn>
        <AndroidUseLatestPlatformSdk>true</AndroidUseLatestPlatformSdk>
        <AndroidApplication>true</AndroidApplication>
        <ApplicationId>com.candy.SurvivalcraftAPI1_9</ApplicationId>
        <AndroidStoreUncompressedFileExtensions>.dll;.so</AndroidStoreUncompressedFileExtensions>
        <AndroidPackageFormat>apk</AndroidPackageFormat>
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
        <AndroidUseDesignerAssembly>true</AndroidUseDesignerAssembly>
        <!--签名-->
        <AndroidKeyStore>true</AndroidKeyStore>
        <AndroidSigningKeyAlias>androiddebugkey</AndroidSigningKeyAlias>
        <AndroidSigningKeyStore>Signing.keystore</AndroidSigningKeyStore>
        <AndroidSigningStorePass>android</AndroidSigningStorePass>
        <AndroidSigningKeyPass>android</AndroidSigningKeyPass>
        <!--优化-->
        <PublishTrimmed>false</PublishTrimmed><!--切记不要修改，如果修改会导致运行时不完整-->
        <TrimMode>partial</TrimMode>
        <AndroidDexTool>d8</AndroidDexTool>
        <AndroidEnableSGenConcurrent>false</AndroidEnableSGenConcurrent>
        <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
        <AndroidLinkMode>None</AndroidLinkMode>
        <AndroidLintEnabled>false</AndroidLintEnabled>
        <AndroidStripILAfterAOT>false</AndroidStripILAfterAOT>
        <AndroidUseInterpreter>false</AndroidUseInterpreter>
        <EnableLLVM>false</EnableLLVM>
        <RunAOTCompilation>false</RunAOTCompilation>
        <NetworkModDestinationDirectory Condition="'$(NetworkModDestinationDirectory)' == ''">$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\InternalMods\</NetworkModDestinationDirectory>
        <CompatibilityModProject Condition="'$(CompatibilityModProject)' == ''">$(MSBuildProjectDirectory)\..\Survivalcraft.CompatNet\Survivalcraft.CompatNet.csproj</CompatibilityModProject>
        <CompatibilityModPackageDirectory Condition="'$(CompatibilityModPackageDirectory)' == ''">$(MSBuildProjectDirectory)\..\Survivalcraft.CompatNet\bin\$(Configuration)\net10.0-windows\win-x64\scmod\</CompatibilityModPackageDirectory>
        <CompatibilityModPackageName Condition="'$(CompatibilityModPackageName)' == ''">Survivalcraft.CompatNet.scmod</CompatibilityModPackageName>
        <CompatibilityModPackagePath Condition="'$(CompatibilityModPackagePath)' == ''">$(CompatibilityModPackageDirectory)$(CompatibilityModPackageName)</CompatibilityModPackagePath>
        <CompatibilityModDestinationDirectory Condition="'$(CompatibilityModDestinationDirectory)' == ''">$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\InternalMods\</CompatibilityModDestinationDirectory>
        <CompatibilityModDestinationFile Condition="'$(CompatibilityModDestinationFile)' == ''">$(CompatibilityModDestinationDirectory)$(CompatibilityModPackageName)</CompatibilityModDestinationFile>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\EntitySystem.Android\EntitySystem.Android.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="MonoMod.Core" Version="1.3.3-daily.26.3.1.2.1" /><!--Source: https://github.com/XiaofengdiZhu/MonoMod.Android/ -->
    </ItemGroup>
    <ItemGroup>
        <AndroidAsset Include="..\Survivalcraft\Content.zip">
            <Link>Assets\Content.zip</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </AndroidAsset>
        <AndroidAsset Include="..\Survivalcraft\init.js">
            <Link>Assets\init.js</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </AndroidAsset>
    </ItemGroup>
    <ItemGroup>
        <Compile Include="MainActivity.cs"/>
        <Compile Include="ImportExternalContentActivity.cs"/>
    </ItemGroup>

    <Import Project="..\build\NetworkMod.targets" />
    <ItemGroup>
        <AndroidAsset Include="$(NetworkModDestinationFile)">
            <Link>Assets\InternalMods\$(NetworkModPackageName)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </AndroidAsset>
        <AndroidAsset Include="$(CompatibilityModDestinationFile)">
            <Link>Assets\InternalMods\$(CompatibilityModPackageName)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </AndroidAsset>
    </ItemGroup>

    <Target Name="PackageAndCopyCompatibilityMod" BeforeTargets="_ComputeAndroidAssetsPaths" AfterTargets="PackageAndCopyNetworkMod" Condition="'$(SkipCompatibilityModPackage)' != 'true' and '$(SkipCompatibilityMods)' != 'true'">
        <MSBuild Projects="$(CompatibilityModProject)" Targets="Restore;Build" Properties="Configuration=$(Configuration);GenerateModPackage=true;TargetFramework=net10.0-windows;WindowsRuntimeIdentifier=win-x64;RuntimeIdentifier=win-x64;ModOutputPath=$(CompatibilityModPackageDirectory)" BuildInParallel="false" />
        <MakeDir Directories="$(CompatibilityModDestinationDirectory)" />
        <Copy SourceFiles="$(CompatibilityModPackagePath)" DestinationFiles="$(CompatibilityModDestinationFile)" SkipUnchangedFiles="true" />
        <Message Importance="high" Text="Copied compatibility mod to $(CompatibilityModDestinationFile)" />
    </Target>
</Project>
